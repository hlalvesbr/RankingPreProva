@inject SessaoState Sessao
@implements IDisposable

@if (aberto)
{
    <div class="menu-usuario-fundo" @onclick="Fechar"></div>
}
<details class="menu-usuario" open="@aberto">
    <summary @onclick="Alternar" @onclick:preventDefault>
        <Avatar Nome="@(Sessao.Usuario?.Nome ?? "?")" Url="@Sessao.Usuario?.AvatarUrl" Tamanho="36" />
    </summary>
    <div class="menu-usuario-painel" @onclick="Fechar">
        @if (Sessao.Usuario is { } u)
        {
            <div class="menu-usuario-topo">
                <strong>@u.Nome</strong>
                <small>@u.Email</small>
                <small class="titulo-nivel">Nível @u.Nivel · @Niveis.Titulo(u.Nivel)</small>
            </div>
        }
        <a href="/perfil">👤 Meu perfil</a>
        <a href="/badges">🏅 Conquistas</a>
        <a href="/historico">📈 Histórico</a>
        <a href="/favoritos">⭐ Favoritos</a>
        <hr />
        <a href="/account/logout" target="_top">🚪 Sair</a>
    </div>
</details>

@code {
    private bool aberto;

    private void Alternar() => aberto = !aberto;

    private void Fechar() => aberto = false;

    protected override void OnInitialized() => Sessao.Mudou += OnMudou;

    private void OnMudou() => InvokeAsync(StateHasChanged);

    public void Dispose() => Sessao.Mudou -= OnMudou;
}
