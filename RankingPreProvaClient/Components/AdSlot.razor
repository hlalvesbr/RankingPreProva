@inject IJSRuntime JS

<div class="ad-bloco">
    <div class="ad-rotulo">Publicidade</div>
    <div class="ad-slot" style="min-height:@(Altura)px">
        @if (config is null)
        {
            <div class="ad-placeholder" style="height:@(Altura)px"></div>
        }
        else if (string.IsNullOrWhiteSpace(config.ClientId) || string.IsNullOrWhiteSpace(config.Slot))
        {
            <div class="ad-placeholder" style="height:@(Altura)px">Espaço publicitário</div>
        }
        else
        {
            <ins class="adsbygoogle"
                 style="display:block;width:100%;height:@(Altura)px"
                 data-ad-client="@config.ClientId"
                 data-ad-slot="@config.Slot"
                 data-ad-format="@Formato"
                 data-full-width-responsive="true"></ins>
        }
    </div>
</div>

@code {
    /// <summary>Posição do anúncio: "lateral", "rodape" ou "conteudo".</summary>
    [Parameter, EditorRequired] public string Posicao { get; set; } = "lateral";
    [Parameter] public int Altura { get; set; } = 250;
    [Parameter] public string Formato { get; set; } = "auto";

    private sealed record AdConfig(string ClientId, string Slot);
    private AdConfig? config;
    private bool carregado;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            config = await JS.InvokeAsync<AdConfig>("rppAds.config", Posicao);
            StateHasChanged();
            return;
        }

        if (!carregado && config is { ClientId.Length: > 0, Slot.Length: > 0 })
        {
            carregado = true;
            await JS.InvokeVoidAsync("rppAds.carregar");
        }
    }
}
