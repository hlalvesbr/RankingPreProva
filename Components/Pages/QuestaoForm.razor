@page "/questoes/nova"
@page "/questoes/editar/{Id:int}"
@using RankingPreProva.Models
@using RankingPreProva.Services
@inject IQuestaoService QuestaoService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(EhEdicao ? "Editar Questão" : "Nova Questão")</PageTitle>

<h1>@(EhEdicao ? "Editar Questão" : "Nova Questão")</h1>

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (questao is null)
{
    <div class="alert alert-warning" role="alert">
        Questão não encontrada.
    </div>
}
else
{
    <EditForm Model="questao" OnValidSubmit="SalvarAsync" FormName="questaoForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrEmpty(mensagemErro))
        {
            <div class="alert alert-danger" role="alert">@mensagemErro</div>
        }

        <div class="mb-3">
            <label for="enunciado" class="form-label">Enunciado</label>
            <InputTextArea id="enunciado" class="form-control" rows="4" @bind-Value="questao.Enunciado" />
            <ValidationMessage For="() => questao.Enunciado" />
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">Opções de Resposta</label>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AdicionarOpcao">Adicionar Opção</button>
            </div>

            @if (questao.Opcoes.Count == 0)
            {
                <p class="text-muted"><em>Nenhuma opção adicionada.</em></p>
            }
            else
            {
                @foreach (var opcao in questao.Opcoes)
                {
                    <div class="input-group mb-2">
                        <div class="input-group-text">
                            <input type="checkbox" class="form-check-input mt-0" checked="@opcao.Correta"
                                   @onchange="e => opcao.Correta = (bool)(e.Value ?? false)" title="Correta" />
                        </div>
                        <InputText class="form-control" @bind-Value="opcao.Texto" placeholder="Texto da opção" />
                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemoverOpcao(opcao)">Remover</button>
                    </div>
                }
            }
        </div>

        <button type="submit" class="btn btn-primary" disabled="@salvando">
            @(salvando ? "Salvando..." : "Salvar")
        </button>
        <a class="btn btn-secondary" href="questoes">Cancelar</a>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private Questao? questao;
    private bool carregando = true;
    private bool salvando;
    private string? mensagemErro;

    private bool EhEdicao => Id.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;

        if (Id.HasValue)
        {
            questao = await QuestaoService.ObterAsync(Id.Value);
        }
        else
        {
            questao = new Questao();
        }

        carregando = false;
    }

    private void AdicionarOpcao()
    {
        questao?.Opcoes.Add(new OpcaoResposta());
    }

    private void RemoverOpcao(OpcaoResposta opcao)
    {
        questao?.Opcoes.Remove(opcao);
    }

    private async Task SalvarAsync()
    {
        if (questao is null)
        {
            return;
        }

        salvando = true;
        mensagemErro = null;

        var resultado = EhEdicao
            ? await QuestaoService.AtualizarAsync(questao)
            : await QuestaoService.CriarAsync(questao);

        salvando = false;

        if (resultado.Sucesso)
        {
            Navigation.NavigateTo("questoes");
        }
        else
        {
            mensagemErro = resultado.Erro;
        }
    }
}
