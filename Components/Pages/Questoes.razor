@page "/questoes"
@using RankingPreProva.Models
@using RankingPreProva.Services
@inject IQuestaoService QuestaoService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Questões</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Questões</h1>
    <a class="btn btn-primary" href="questoes/nova">Nova Questão</a>
</div>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success" role="alert">@mensagemSucesso</div>
}

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger" role="alert">@mensagemErro</div>
}

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (questoes.Count == 0)
{
    <div class="alert alert-info" role="alert">
        Nenhuma questão cadastrada.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width: 60px;">#</th>
                <th>Enunciado</th>
                <th style="width: 90px;">Opções</th>
                <th style="width: 160px;">Criado em</th>
                <th style="width: 180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var questao in questoes)
            {
                <tr>
                    <td>@questao.Id</td>
                    <td>@questao.Enunciado</td>
                    <td>@questao.Opcoes.Count</td>
                    <td>@questao.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="@($"questoes/editar/{questao.Id}")">Editar</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirConfirmacao(questao)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (questaoParaExcluir is not null)
{
    <ConfirmDialog Visivel="true"
                   Titulo="Confirmar exclusão"
                   TextoConfirmar="Excluir"
                   TextoProcessando="Excluindo..."
                   Processando="excluindo"
                   OnConfirmar="ConfirmarExclusaoAsync"
                   OnCancelar="FecharConfirmacao">
        <p>Tem certeza que deseja excluir esta questão?</p>
        <p class="text-muted mb-0"><small>@questaoParaExcluir.Enunciado</small></p>
    </ConfirmDialog>
}

@code {
    private List<Questao> questoes = new();
    private bool carregando = true;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private Questao? questaoParaExcluir;
    private bool excluindo;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        carregando = true;
        questoes = await QuestaoService.ListarAsync();
        carregando = false;
    }

    private void AbrirConfirmacao(Questao questao)
    {
        mensagemErro = null;
        mensagemSucesso = null;
        questaoParaExcluir = questao;
    }

    private void FecharConfirmacao()
    {
        questaoParaExcluir = null;
    }

    private async Task ConfirmarExclusaoAsync()
    {
        if (questaoParaExcluir is null)
        {
            return;
        }

        excluindo = true;

        var (sucesso, erro) = await QuestaoService.RemoverAsync(questaoParaExcluir.Id);

        excluindo = false;
        questaoParaExcluir = null;

        if (sucesso)
        {
            mensagemSucesso = "Questão excluída com sucesso.";
            await CarregarAsync();
        }
        else
        {
            mensagemErro = erro;
        }
    }
}
