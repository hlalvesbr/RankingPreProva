@page "/provas"
@using RankingPreProva.Models
@using RankingPreProva.Services
@inject IProvaService ProvaService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Provas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Provas</h1>
    <a class="btn btn-primary" href="provas/nova">Nova Prova</a>
</div>

@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success" role="alert">@mensagemSucesso</div>
}

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger" role="alert">@mensagemErro</div>
}

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else if (provas.Count == 0)
{
    <div class="alert alert-info" role="alert">
        Nenhuma prova cadastrada.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width: 60px;">#</th>
                <th>Título</th>
                <th>Descrição</th>
                <th style="width: 90px;">Questões</th>
                <th style="width: 160px;">Criado em</th>
                <th style="width: 180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prova in provas)
            {
                <tr>
                    <td>@prova.Id</td>
                    <td>@prova.Titulo</td>
                    <td>@prova.Descricao</td>
                    <td>@prova.ProvaQuestoes.Count</td>
                    <td>@prova.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="@($"provas/editar/{prova.Id}")">Editar</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirConfirmacao(prova)">Excluir</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (provaParaExcluir is not null)
{
    <ConfirmDialog Visivel="true"
                   Titulo="Confirmar exclusão"
                   TextoConfirmar="Excluir"
                   TextoProcessando="Excluindo..."
                   Processando="excluindo"
                   OnConfirmar="ConfirmarExclusaoAsync"
                   OnCancelar="FecharConfirmacao">
        <p>Tem certeza que deseja excluir esta prova?</p>
        <p class="text-muted mb-0"><small>@provaParaExcluir.Titulo</small></p>
    </ConfirmDialog>
}

@code {
    private List<Prova> provas = new();
    private bool carregando = true;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private Prova? provaParaExcluir;
    private bool excluindo;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        carregando = true;
        provas = await ProvaService.ListarAsync();
        carregando = false;
    }

    private void AbrirConfirmacao(Prova prova)
    {
        mensagemErro = null;
        mensagemSucesso = null;
        provaParaExcluir = prova;
    }

    private void FecharConfirmacao()
    {
        provaParaExcluir = null;
    }

    private async Task ConfirmarExclusaoAsync()
    {
        if (provaParaExcluir is null)
        {
            return;
        }

        excluindo = true;

        var (sucesso, erro) = await ProvaService.RemoverAsync(provaParaExcluir.Id);

        excluindo = false;
        provaParaExcluir = null;

        if (sucesso)
        {
            mensagemSucesso = "Prova excluída com sucesso.";
            await CarregarAsync();
        }
        else
        {
            mensagemErro = erro;
        }
    }
}
