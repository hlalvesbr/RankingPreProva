@namespace RankingPreProva.Components.Shared

@if (Visivel)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Titulo</h5>
                    <button type="button" class="btn-close" aria-label="Fechar" @onclick="OnCancelarAsync" disabled="@Processando"></button>
                </div>
                <div class="modal-body">
                    @ChildContent
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="OnCancelarAsync" disabled="@Processando">
                        @TextoCancelar
                    </button>
                    <button type="button" class="btn @ClasseBotaoConfirmar" @onclick="OnConfirmarAsync" disabled="@Processando">
                        @(Processando ? TextoProcessando : TextoConfirmar)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public bool Visivel { get; set; }

    [Parameter]
    public string Titulo { get; set; } = "Confirmar";

    [Parameter]
    public string TextoConfirmar { get; set; } = "Confirmar";

    [Parameter]
    public string TextoCancelar { get; set; } = "Cancelar";

    [Parameter]
    public string TextoProcessando { get; set; } = "Processando...";

    [Parameter]
    public string ClasseBotaoConfirmar { get; set; } = "btn-danger";

    [Parameter]
    public bool Processando { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnConfirmar { get; set; }

    [Parameter]
    public EventCallback OnCancelar { get; set; }

    private Task OnConfirmarAsync() => OnConfirmar.InvokeAsync();

    private Task OnCancelarAsync() => OnCancelar.InvokeAsync();
}
