@inject IConfiguration Config
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <title>RankingPréProva</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@700;900&display=swap" />
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RankingPreProva.Server.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <meta name="adsense-client" content="@AdClient" />
    <meta name="adsense-slot-lateral" content="@Config["AdSense:Slots:Lateral"]" />
    <meta name="adsense-slot-rodape" content="@Config["AdSense:Slots:Rodape"]" />
    <meta name="adsense-slot-conteudo" content="@Config["AdSense:Slots:Conteudo"]" />
    @if (!string.IsNullOrWhiteSpace(AdClient))
    {
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@AdClient" crossorigin="anonymous"></script>
    }
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    @if (PageRenderMode is not null)
    {
        <div id="app-splash">
            <div class="splash-logo">📚</div>
            <div class="splash-nome">Ranking<span>PréProva</span></div>
            <div class="splash-barra"><span></span></div>
            <div class="splash-dica">Preparando sua mesa de estudos…</div>
        </div>
    }
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["js/rpp.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? AdClient => Config["AdSense:ClientId"];

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveWebAssemblyRenderMode(prerender: false) : null;
}
